.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
}
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}
.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin: 24rpx 0 12rpx;
}
.label:first-child {
  margin-top: 0;
}
.input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}
.row {
  display: flex;
  gap: 16rpx;
}
.flex {
  flex: 1;
}
.picker {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 28rpx;
  font-size: 30rpx;
  min-width: 120rpx;
  text-align: center;
}
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.quick-btn {
  background: #e8f5e9;
  color: #2e7d32;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.preview {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #e8f5e9;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.preview-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #2e7d32;
}
.tip {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}
.btn-save {
  margin-top: 40rpx;
  background: #4CAF50 !important;
  color: #fff !important;
  border-radius: 48rpx;
  font-size: 32rpx;
}
