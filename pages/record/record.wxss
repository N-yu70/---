.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  padding-bottom: 120rpx;
}
.entry-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.entry-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.entry-item.active {
  border: 2rpx solid #4CAF50;
  color: #4CAF50;
}
.entry-item.disabled {
  opacity: 0.55;
}
.entry-icon {
  display: block;
  font-size: 36rpx;
  margin-bottom: 6rpx;
}
.summary {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0 16rpx;
  font-size: 26rpx;
  color: #888;
}
.sum-cal {
  color: #4CAF50;
  font-weight: 600;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.card-main {
  flex: 1;
  min-width: 60%;
}
.food-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}
.food-meta {
  font-size: 26rpx;
  color: #888;
}
.card-cal {
  font-size: 30rpx;
  color: #4CAF50;
  font-weight: 600;
}
.card-actions {
  width: 100%;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 32rpx;
}
.action {
  font-size: 26rpx;
  color: #4CAF50;
}
.action.del {
  color: #f44336;
}
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}
.btn-add {
  margin-top: 24rpx;
  background: #4CAF50 !important;
  color: #fff !important;
  border-radius: 48rpx;
  width: 240rpx !important;
  font-size: 28rpx !important;
}
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 96rpx;
  height: 96rpx;
  background: #4CAF50;
  color: #fff;
  border-radius: 50%;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.4);
}
