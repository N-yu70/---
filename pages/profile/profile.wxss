.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  padding-bottom: 60rpx;
}
.hero {
  background: linear-gradient(135deg, #4CAF50, #81C784);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.app-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}
.app-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}
.openid,
.dev-hint {
  display: block;
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.field:last-child {
  border-bottom: none;
}
.field-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
}
.field-input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
}
.picker-val {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
}
.textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.target-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.target-input {
  font-size: 48rpx;
  font-weight: 700;
  color: #4CAF50;
  width: 200rpx;
}
.target-unit {
  font-size: 28rpx;
  color: #888;
  margin-left: 12rpx;
}
.btn-outline {
  background: #e8f5e9 !important;
  color: #2e7d32 !important;
  font-size: 28rpx !important;
  border-radius: 48rpx !important;
}
.btn-save {
  background: #4CAF50 !important;
  color: #fff !important;
  border-radius: 48rpx;
  margin-top: 8rpx;
}
.btn-danger {
  margin-top: 16rpx;
  background: #fff !important;
  color: #f44336 !important;
  border: 1rpx solid #ffcdd2 !important;
  border-radius: 48rpx;
  font-size: 28rpx !important;
}
.footer {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 32rpx;
}
