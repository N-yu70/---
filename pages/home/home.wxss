.offline-tip {
  background: #fff3e0;
  color: #e65100;
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}
.header-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}
.date {
  font-size: 26rpx;
  color: #888;
}
.status-bar {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 16rpx;
  border-left: 6rpx solid #4CAF50;
}
.status-hint {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}
.status-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}
.advice-card {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #e8f5e9 0%, #fff 100%);
  border-radius: 24rpx;
  padding: 28rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2e7d32;
  margin-bottom: 12rpx;
}
.advice-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}
.advice-tag {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #aaa;
}
.section {
  margin-top: 32rpx;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
}
.link {
  font-size: 28rpx;
  color: #4CAF50;
}
.meal-block {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.meal-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.meal-name {
  font-weight: 600;
  font-size: 30rpx;
}
.meal-cal {
  color: #4CAF50;
  font-size: 28rpx;
}
.food-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 0;
}
.food-cal {
  color: #999;
}
.more {
  font-size: 24rpx;
  color: #bbb;
}
.empty {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}
.empty-title {
  display: block;
  font-size: 32rpx;
  color: #333;
}
.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin: 16rpx 0 32rpx;
}
.btn-primary {
  background: #4CAF50 !important;
  color: #fff !important;
  border-radius: 48rpx;
  font-size: 30rpx;
  width: 280rpx !important;
}
