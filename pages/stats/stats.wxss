.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
}
.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
}
.tab.active {
  background: #4CAF50;
  color: #fff;
  font-weight: 600;
}
.summary-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.sum-label {
  font-size: 26rpx;
  color: #888;
}
.sum-val {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #333;
  margin: 8rpx 0;
}
.unit {
  font-size: 28rpx;
  font-weight: normal;
  color: #888;
}
.sum-target {
  font-size: 26rpx;
  color: #4CAF50;
}
.chart-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 24rpx;
}
.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 320rpx;
  padding: 0 8rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 80rpx;
}
.bar-value {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 8rpx;
  min-height: 32rpx;
}
.bar-track {
  width: 48rpx;
  height: 220rpx;
  background: #f0f0f0;
  border-radius: 8rpx 8rpx 0 0;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.bar-inner {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 0;
  transition: height 0.25s;
}
.bar-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 12rpx;
}
.chart-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #bbb;
  font-size: 28rpx;
}
.w-label {
  width: 100rpx !important;
}
.detail-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
}
.detail-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 12rpx;
}
.detail-row:last-child {
  border-bottom: none;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.detail-label {
  width: 80rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}
.bar-bg {
  flex: 1;
  height: 16rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
}
.bar-bg.flex1 {
  flex: 1;
}
.bar-fill {
  height: 100%;
  background: #4CAF50;
  border-radius: 8rpx;
}
.detail-cal {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  color: #666;
}
